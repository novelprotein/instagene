<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-fasta">
    <comment>FASTA sequence</comment>
    <glob pattern="*.fa"/>
    <glob pattern="*.fasta"/>
    <glob pattern="*.fna"/>
    <glob pattern="*.fas"/>
  </mime-type>
  <mime-type type="chemical/x-genbank">
    <comment>GenBank sequence</comment>
    <glob pattern="*.gb"/>
    <glob pattern="*.gbk"/>
    <glob pattern="*.genbank"/>
    <glob pattern="*.ape"/>
  </mime-type>
  <mime-type type="text/x-gff3">
    <comment>GFF3 annotation file</comment>
    <glob pattern="*.gff"/>
    <glob pattern="*.gff3"/>
  </mime-type>
  <mime-type type="text/x-embl">
    <comment>EMBL/ENA sequence</comment>
    <glob pattern="*.embl"/>
    <glob pattern="*.ena"/>
  </mime-type>
  <mime-type type="chemical/x-swiss-prot">
    <comment>Swiss-Prot sequence</comment>
    <glob pattern="*.swiss"/>
    <glob pattern="*.sprot"/>
    <glob pattern="*.dat"/>
  </mime-type>
  <mime-type type="text/x-fasta-alignment">
    <comment>FASTA alignment</comment>
    <glob pattern="*.aln"/>
    <glob pattern="*.afa"/>
    <glob pattern="*.msa"/>
  </mime-type>
</mime-info>
