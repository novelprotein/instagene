#!/usr/bin/env bash
#
# InstaGene pre-commit hook: the local CI gate.
#
# Runs the build, strict documentation validation, and host-supported
# distribution checks before a commit so common CI failures are caught locally.
#
# Install with:  ./scripts/install-hooks.sh   (or: git config core.hooksPath .githooks)
# Bypass once with:  git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

require_staged_changes() {
    if ! git diff --quiet --ignore-submodules=none; then
        echo 'Commit blocked: stage or restore all unstaged tracked changes before validation.' >&2
        exit 1
    fi
}

require_staged_changes
staged_tree="$(git write-tree)"
if ! bash "$ROOT/scripts/check-ci.sh"; then
    echo 'Commit blocked: local checks failed.' >&2
    exit 1
fi
require_staged_changes
if [[ "$(git write-tree)" != "$staged_tree" ]]; then
    echo 'Commit blocked: staged files changed during validation. Commit again to recheck them.' >&2
    exit 1
fi

echo "== Commit OK: local CI gate passed =="
