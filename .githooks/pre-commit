#!/usr/bin/env bash
#
# InstaGene pre-commit hook: the local CI gate.
#
# Runs the build, strict documentation validation, and host-supported
# distribution checks before a commit so common CI failures are caught locally.
#
# Install with:  ./scripts/install-hooks.sh   (or: git config core.hooksPath .githooks)
# Bypass once with:  git commit --no-verify
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Recording a merge/revert/cherry-pick resolution: tests already ran on the
# committed histories, so do not re-run the whole suite here.
if [ -f "$ROOT/.git/MERGE_HEAD" ] || [ -f "$ROOT/.git/CHERRY_PICK_HEAD" ] || [ -f "$ROOT/.git/REVERT_HEAD" ]; then
    exit 0
fi

run_gate() {
    label="$1"
    shift
    echo "== InstaGene: $label =="
    if ! "$@"; then
        echo
        echo "Commit blocked: $label failed."
        echo "Fix the failures, then commit again (or bypass with: git commit --no-verify)."
        exit 1
    fi
}

run_gate "building all modules and running tests" ./gradlew build --console=plain
run_gate "building documentation in strict mode" ./scripts/check-docs.sh
run_gate "checking distributions" ./scripts/check-distributions.sh

echo "== Commit OK: local CI gate passed =="
